# Resend API key. The contact form shows its unavailable state without this.
# Server-only: never prefix with NEXT_PUBLIC, or the key ships to the browser.
RESEND_API_KEY=re_your_key_here

# Sender address for contact notifications. Must sit on the domain verified in
# Resend, not the Google Workspace inbox domain.
CONTACT_FROM_EMAIL=contact@send.bradleyexton.ca

# Where contact submissions are delivered. Defaults to the profile email.
CONTACT_TO_EMAIL=bradley@bradleyexton.ca

# Cal.com booking URL
# Example: https://cal.com/bradleyexton/30min
NEXT_PUBLIC_CALCOM_URL=https://cal.com/your-username/30min

# GA4 measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification token
# The content value from the HTML tag verification method
GOOGLE_SITE_VERIFICATION=your_verification_token_here

# Under construction mode
# Set to "true" to show coming soon page, remove or set to "false" for live site
UNDER_CONSTRUCTION=false
